{% comment %}
  OurCoordinates — How It Works (3-Step Guide)
  Use on product pages and landing pages.
  Reduces first-time buyer anxiety about the personalization process.
  Requires: occ-conversion.css
{% endcomment %}

{{ 'occ-conversion.css' | asset_url | stylesheet_tag }}

<section class="occ-hiw{% if section.settings.background_style == 'dark' %} occ-hiw--dark{% endif %}">
  <div style="max-width:1100px;margin:0 auto;padding:0 20px;">
    {%- if section.settings.heading != blank -%}
      <h2 class="occ-hiw__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.subheading != blank -%}
      <p class="occ-hiw__subheading">{{ section.settings.subheading }}</p>
    {%- endif -%}

    <div class="occ-hiw__steps">
      {%- for i in (1..3) -%}
        {%- assign icon_key  = 'step_' | append: i | append: '_icon' -%}
        {%- assign title_key = 'step_' | append: i | append: '_title' -%}
        {%- assign text_key  = 'step_' | append: i | append: '_text' -%}
        {%- assign step_icon  = section.settings[icon_key] -%}
        {%- assign step_title = section.settings[title_key] -%}
        {%- assign step_text  = section.settings[text_key] -%}

        <div class="occ-hiw__step">
          <div class="occ-hiw__step-icon" aria-hidden="true">
            <span style="font-size:26px;">{{ step_icon }}</span>
            <span class="occ-hiw__step-number">{{ i }}</span>
          </div>
          {%- if step_title != blank -%}
            <h3 class="occ-hiw__step-title">{{ step_title }}</h3>
          {%- endif -%}
          {%- if step_text != blank -%}
            <p class="occ-hiw__step-text">{{ step_text }}</p>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "OCC How It Works",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "How It Works"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Your coordinates, engraved exactly as you envision — in 3 simple steps."
    },
    {
      "type": "select",
      "id": "background_style",
      "label": "Background style",
      "options": [
        { "value": "light", "label": "Light" },
        { "value": "dark",  "label": "Dark" }
      ],
      "default": "light"
    },
    {
      "type": "header",
      "content": "Step 1"
    },
    {
      "type": "text",
      "id": "step_1_icon",
      "label": "Icon (emoji)",
      "default": "🔍"
    },
    {
      "type": "text",
      "id": "step_1_title",
      "label": "Title",
      "default": "Search Your Place"
    },
    {
      "type": "textarea",
      "id": "step_1_text",
      "label": "Description",
      "default": "Type any address, city, or landmark. We'll find the exact coordinates automatically."
    },
    {
      "type": "header",
      "content": "Step 2"
    },
    {
      "type": "text",
      "id": "step_2_icon",
      "label": "Icon (emoji)",
      "default": "✏️"
    },
    {
      "type": "text",
      "id": "step_2_title",
      "label": "Title",
      "default": "Preview Your Engraving"
    },
    {
      "type": "textarea",
      "id": "step_2_text",
      "label": "Description",
      "default": "See exactly how your coordinates will appear on the piece before you order."
    },
    {
      "type": "header",
      "content": "Step 3"
    },
    {
      "type": "text",
      "id": "step_3_icon",
      "label": "Icon (emoji)",
      "default": "📦"
    },
    {
      "type": "text",
      "id": "step_3_title",
      "label": "Title",
      "default": "We Create & Ship"
    },
    {
      "type": "textarea",
      "id": "step_3_text",
      "label": "Description",
      "default": "Handcrafted with care and shipped within 3–5 business days in beautiful gift packaging."
    }
  ],
  "presets": [
    {
      "name": "OCC How It Works"
    }
  ]
}
{% endschema %}
