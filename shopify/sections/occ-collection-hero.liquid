{% comment %}
  OurCoordinates — Collection Page Hero Banner
  Place at the top of collection template pages.
  Shows heading, subheading, optional trust tagline, and quick-nav links.
  Requires: occ-conversion.css
{% endcomment %}

{{ 'occ-conversion.css' | asset_url | stylesheet_tag }}

<div class="occ-collection-hero">
  {%- if section.settings.hero_image != blank -%}
    <img
      class="occ-collection-hero__bg"
      src="{{ section.settings.hero_image | image_url: width: 1400 }}"
      alt=""
      role="presentation"
      loading="eager"
      fetchpriority="high"
    >
    <div class="occ-collection-hero__overlay"></div>
  {%- else -%}
    <div style="position:absolute;inset:0;background:linear-gradient(135deg,#1a1a1a 0%,#2c2416 100%);"></div>
  {%- endif -%}

  <div class="occ-collection-hero__content">
    {%- if section.settings.show_trust_tagline and section.settings.trust_tagline != blank -%}
      <div class="occ-collection-hero__tagline">
        <span aria-hidden="true">✦</span>
        {{ section.settings.trust_tagline }}
      </div>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h1 class="occ-collection-hero__heading">{{ section.settings.heading }}</h1>
    {%- else -%}
      <h1 class="occ-collection-hero__heading">{{ collection.title }}</h1>
    {%- endif -%}

    {%- if section.settings.subheading != blank -%}
      <p class="occ-collection-hero__subheading">{{ section.settings.subheading }}</p>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <nav class="occ-collection-hero__nav" aria-label="Browse categories">
        {%- for block in section.blocks -%}
          {%- if block.type == 'nav_link' -%}
            <a
              href="{{ block.settings.link_url }}"
              class="occ-collection-hero__nav-link{% if block.settings.link_url == request.path %} occ-collection-hero__nav-link--active{% endif %}"
              {{ block.shopify_attributes }}
            >
              {{ block.settings.link_label }}
            </a>
          {%- endif -%}
        {%- endfor -%}
      </nav>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "OCC Collection Hero",
  "tag": "div",
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Background image",
      "info": "Recommended: 1400×400px. Overlay is applied automatically."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Leave blank to use the collection title automatically."
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Every coordinate tells your story"
    },
    {
      "type": "checkbox",
      "id": "show_trust_tagline",
      "label": "Show trust tagline",
      "default": true
    },
    {
      "type": "text",
      "id": "trust_tagline",
      "label": "Trust tagline text",
      "default": "Free Engraving · Waterproof · Ships in 3–5 Days"
    }
  ],
  "blocks": [
    {
      "type": "nav_link",
      "name": "Category link",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label",
          "default": "Bracelets"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Link URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "OCC Collection Hero",
      "blocks": [
        {
          "type": "nav_link",
          "settings": {
            "link_label": "Coordinates Bracelets",
            "link_url": "/collections/coordinates-bracelets"
          }
        },
        {
          "type": "nav_link",
          "settings": {
            "link_label": "Coordinates Necklaces",
            "link_url": "/collections/coordinates-necklaces"
          }
        },
        {
          "type": "nav_link",
          "settings": {
            "link_label": "Couple Bracelets",
            "link_url": "/collections/couple-bracelets"
          }
        }
      ]
    }
  ]
}
{% endschema %}
