{% comment %}
  OurCoordinates — Sticky Add-to-Cart Bar
  Place this section in your product template.
  Requires: occ-conversion.css, occ-conversion.js
{% endcomment %}

{{ 'occ-conversion.css' | asset_url | stylesheet_tag }}

{% if section.settings.enable_sticky_atc %}
  {%- assign current_variant = product.selected_or_first_available_variant -%}

  <div
    class="occ-sticky"
    data-watch-selector="{{ section.settings.watch_selector | default: '#MainProduct-form, form[action=\"/cart/add\"]' }}"
    data-variant-id="{{ current_variant.id }}"
    style="--occ-sticky-bg: {{ section.settings.background_color }}; --occ-sticky-btn: {{ section.settings.button_color }};"
  >
    <div class="occ-sticky__inner">
      {%- if product.featured_image -%}
        <img
          class="occ-sticky__image"
          src="{{ product.featured_image | image_url: width: 96 }}"
          alt="{{ product.featured_image.alt | escape }}"
          width="48"
          height="48"
          loading="lazy"
        >
      {%- endif -%}

      <div class="occ-sticky__info">
        <p class="occ-sticky__title">{{ product.title }}</p>
        <p class="occ-sticky__price">
          {%- if current_variant.compare_at_price > current_variant.price -%}
            <s style="opacity:0.5;margin-right:6px;">{{ current_variant.compare_at_price | money }}</s>
          {%- endif -%}
          {{ current_variant.price | money }}
        </p>
      </div>

      {%- if product.variants.size > 1 -%}
        <select class="occ-sticky__variant-select" aria-label="Select variant">
          {%- for variant in product.variants -%}
            <option
              value="{{ variant.id }}"
              {% if variant.id == current_variant.id %}selected{% endif %}
              {% unless variant.available %}disabled{% endunless %}
            >
              {{ variant.title }}{% unless variant.available %} — Sold out{% endunless %}
            </option>
          {%- endfor -%}
        </select>
      {%- endif -%}

      <button class="occ-sticky__btn" type="button">
        {{- section.settings.button_label | default: 'Add to Cart' -}}
      </button>
    </div>
  </div>

  <style>
    .occ-sticky { background: {{ section.settings.background_color }}; }
    .occ-sticky__btn { background: {{ section.settings.button_color }}; }
  </style>
{% endif %}

<script>
  if (!document.documentElement.dataset.occJsLoaded) {
    document.documentElement.dataset.occJsLoaded = 'true';
    var s = document.createElement('script');
    s.src = {{ 'occ-conversion.js' | asset_url | json }};
    s.defer = true;
    document.head.appendChild(s);
  }
</script>

{% schema %}
{
  "name": "OCC Sticky Add-to-Cart",
  "tag": "div",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_sticky_atc",
      "label": "Enable sticky ATC bar",
      "default": true
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Bar background color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button color",
      "default": "#d4a853"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button text",
      "default": "Add to Cart"
    },
    {
      "type": "text",
      "id": "watch_selector",
      "label": "CSS selector for product form (advanced)",
      "info": "The element to watch — bar appears when this scrolls out of view. Leave blank for default.",
      "placeholder": "#MainProduct-form"
    }
  ],
  "presets": [
    {
      "name": "OCC Sticky Add-to-Cart"
    }
  ]
}
{% endschema %}
